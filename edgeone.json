{
  "name": "merchantops-copilot",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "./dist",
  "nodeVersion": "22.11.0",
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "cloudFunctions": {
    "regions": {
      "mainland": ["ap-guangzhou"]
    },
    "maxDuration": 30
  }
}
